{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "redirects": [{ "source": "/", "destination": "/gateway", "permanent": false }],
  "rewrites": [
    { "source": "/gateway/fonts/:path*", "destination": "/fonts/:path*" },
    { "source": "/gateway/theme.js", "destination": "/theme.js" },
    { "source": "/gateway/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/gateway/api/:path*", "destination": "/api/:path*" },
    { "source": "/gateway/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/gateway", "destination": "/index.html" },
    { "source": "/gateway/", "destination": "/index.html" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" },
      { "key": "X-Robots-Tag", "value": "index, follow" }
    ]
  }]
}
